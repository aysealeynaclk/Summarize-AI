# PostgreSQL bağlantısı
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/summarize_ai

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# İlk admin hesabı (uygulama ilk açılışta otomatik oluşturur)
ADMIN_USERNAME_OR_EMAIL=admin@summarize-ai.com
ADMIN_PASSWORD=ChangeMe123!

# CORS - Vue dev server adresi
FRONTEND_ORIGIN=http://localhost:5173
